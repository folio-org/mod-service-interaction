<?xml version="1.0" encoding="UTF-8"?>
<!-- Adoption baseline (ADR-005) for the dashboards/widgets slice:
     external_user, dashboard, widget_type, widget_definition,
     widget_instance, dashboard_access, dashboard_display_data. Column set
     and constraint names transcribed from the legacy Groovy changelogs
     (initial-model.groovy, service-interaction-1-3.groovy,
     service-interaction-3-0.groovy) in their FINAL state — e.g. dashboard
     has no dshb_owner_fk (dropped by 2022-08-11-1021-007) and carries the
     later dshb_description column. Each table's changeset MARK_RANs when
     the table already exists, so populated legacy schemas are adopted
     untouched. -->
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="adopt-external-user" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="external_user"/></not>
    </preConditions>
    <createTable tableName="external_user">
      <column name="eu_id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="externalUserPK"/></column>
      <column name="eu_version" type="BIGINT"><constraints nullable="false"/></column>
    </createTable>
  </changeSet>

  <changeSet id="adopt-dashboard" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="dashboard"/></not>
    </preConditions>
    <createTable tableName="dashboard">
      <column name="dshb_id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="dashboardPK"/></column>
      <column name="dshb_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="dshb_name" type="VARCHAR(255)"/>
      <column name="dshb_description" type="TEXT"/>
    </createTable>
  </changeSet>

  <changeSet id="adopt-widget-type" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="widget_type"/></not>
    </preConditions>
    <createTable tableName="widget_type">
      <column name="wtype_id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="widgetTypePK"/></column>
      <column name="wtype_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="wtype_type_version" type="VARCHAR(36)"/>
      <column name="wtype_name" type="VARCHAR(255)"/>
      <column name="wtype_schema" type="TEXT"/>
    </createTable>
    <addUniqueConstraint columnNames="wtype_name, wtype_type_version"
      constraintName="widget_type_name_version_unique" tableName="widget_type"/>
  </changeSet>

  <changeSet id="adopt-widget-definition" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="widget_definition"/></not>
    </preConditions>
    <createTable tableName="widget_definition">
      <column name="wdef_id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="widgetDefinitionPK"/></column>
      <column name="wdef_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="wdef_definition_version" type="VARCHAR(36)"/>
      <column name="wdef_name" type="VARCHAR(255)"/>
      <column name="wdef_definition" type="TEXT"/>
      <column name="wdef_type_name" type="VARCHAR(255)"/>
      <column name="wdef_type_version" type="VARCHAR(36)"/>
    </createTable>
    <addUniqueConstraint columnNames="wdef_name, wdef_definition_version"
      constraintName="widget_definition_name_version_unique" tableName="widget_definition"/>
  </changeSet>

  <changeSet id="adopt-widget-instance" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="widget_instance"/></not>
    </preConditions>
    <createTable tableName="widget_instance">
      <column name="wins_id" type="VARCHAR(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="widgetInstancePK"/></column>
      <column name="wins_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="wins_name" type="VARCHAR(255)"/>
      <column name="wins_definition_name" type="VARCHAR(255)"/>
      <column name="wins_definition_version" type="VARCHAR(36)"/>
      <column name="wins_owner_fk" type="VARCHAR(36)"/>
      <column name="wins_configuration" type="TEXT"/>
      <column name="wins_weight" type="BIGINT"/>
    </createTable>
    <addForeignKeyConstraint baseColumnNames="wins_owner_fk" baseTableName="widget_instance"
      constraintName="widget_instance_owner_fk"
      referencedColumnNames="dshb_id" referencedTableName="dashboard"/>
  </changeSet>

  <changeSet id="adopt-dashboard-access" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="dashboard_access"/></not>
    </preConditions>
    <createTable tableName="dashboard_access">
      <!-- Legacy declares NO primary key on this table — NOT NULL only (M4-verified). -->
      <column name="da_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="da_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="da_dashboard_fk" type="VARCHAR(36)"/>
      <column name="da_user_fk" type="VARCHAR(36)"/>
      <column name="da_access_fk" type="VARCHAR(36)"/>
      <column name="da_date_created" type="TIMESTAMP WITHOUT TIME ZONE"/>
      <column name="da_user_dashboard_weight" type="BIGINT"/>
      <column name="da_default_user_dashboard" type="BOOLEAN"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseColumnNames="da_dashboard_fk" baseTableName="dashboard_access"
      constraintName="dashboard_access_dashboard_FK"
      referencedColumnNames="dshb_id" referencedTableName="dashboard"/>
    <addForeignKeyConstraint baseColumnNames="da_user_fk" baseTableName="dashboard_access"
      constraintName="dashboard_access_user_FK"
      referencedColumnNames="eu_id" referencedTableName="external_user"/>
    <addForeignKeyConstraint baseColumnNames="da_access_fk" baseTableName="dashboard_access"
      constraintName="dashboard_access_access_FK"
      referencedColumnNames="rdv_id" referencedTableName="refdata_value"/>
  </changeSet>

  <changeSet id="adopt-dashboard-display-data" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="dashboard_display_data"/></not>
    </preConditions>
    <createTable tableName="dashboard_display_data">
      <!-- Legacy declares NO primary key on this table — NOT NULL only (M4-verified). -->
      <column name="ddd_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="ddd_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="ddd_dash_id" type="VARCHAR(36)"/>
      <column name="ddd_layout_data" type="TEXT"/>
    </createTable>
    <addUniqueConstraint columnNames="ddd_dash_id"
      constraintName="dashboard_display_data_dash_id_unique" tableName="dashboard_display_data"/>
  </changeSet>

</databaseChangeLog>
