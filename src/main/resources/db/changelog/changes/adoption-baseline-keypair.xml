<?xml version="1.0" encoding="UTF-8"?>
<!-- Adoption baseline (ADR-005) for the attestation slice: db_key_pair.
     Column set transcribed from the legacy Groovy changelog
     (service-interaction-4-3.groovy) — which declares NO primary key on
     kp_id, only NOT NULL; reproduced verbatim so adopted legacy schemas
     and freshly created ones are identical. MARK_RANs when the table
     already exists. -->
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="adopt-db-key-pair" author="mod-service-interaction-java">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="db_key_pair"/></not>
    </preConditions>
    <createTable tableName="db_key_pair">
      <column name="kp_id" type="VARCHAR(36)"><constraints nullable="false"/></column>
      <column name="kp_version" type="BIGINT"><constraints nullable="false"/></column>
      <column name="kp_available_from" type="TIMESTAMP WITHOUT TIME ZONE"/>
      <column name="kp_expires_at" type="TIMESTAMP WITHOUT TIME ZONE"/>
      <column name="kp_usage" type="VARCHAR(32)"/>
      <column name="kp_alg" type="VARCHAR(32)"/>
      <column name="kp_public_key" type="text"/>
      <column name="kp_private_key" type="text"/>
    </createTable>
  </changeSet>

</databaseChangeLog>
