{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.dev/schemas/dto-model-mappings.schema.json",
  "title": "SDD Model/DTO Mapping Specification",
  "description": "Schema for specs/mappings/*.(yaml|yml|json) documents. Maps between model entities and DTO schemas in either direction. One mapping payload per file.",
  "type": "object",
  "required": ["id", "name", "source", "target", "field_mappings"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "source": { "$ref": "#/$defs/endpoint" },
    "target": { "$ref": "#/$defs/endpoint" },
    "field_mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/field_mapping" }
    },
    "refs": { "$ref": "#/$defs/ref_list" }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["model", "dto"]
        },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "field_mapping": {
      "type": "object",
      "required": ["source_field", "target_field"],
      "additionalProperties": false,
      "properties": {
        "source_field": { "type": "string", "minLength": 1 },
        "target_field": { "type": "string", "minLength": 1 },
        "transform": { "type": "string", "minLength": 1 },
        "expression": { "type": "object", "minProperties": 1 }
      },
      "oneOf": [
        { "required": ["transform"] },
        { "required": ["expression"] }
      ]
    },
    "expression": {
      "description": "Governed expression DSL (documented here, validated by MappingsValidator post-schema pass).",
      "oneOf": [
        { "$ref": "#/$defs/ref_leaf" },
        { "$ref": "#/$defs/value_leaf" },
        { "$ref": "#/$defs/computed_node" },
        { "$ref": "#/$defs/conditional_node" },
        { "$ref": "#/$defs/predicate_node" }
      ]
    },
    "ref_leaf": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "value_leaf": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {}
      }
    },
    "computed_node": {
      "type": "object",
      "required": ["op", "args"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "concat" },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expression" }
        }
      }
    },
    "conditional_node": {
      "type": "object",
      "required": ["op", "condition", "then", "else"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "if" },
        "condition": { "$ref": "#/$defs/expression" },
        "then": { "$ref": "#/$defs/expression" },
        "else": { "$ref": "#/$defs/expression" }
      }
    },
    "predicate_node": {
      "type": "object",
      "required": ["op", "left", "right"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "equals" },
        "left": { "$ref": "#/$defs/expression" },
        "right": { "$ref": "#/$defs/expression" }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^\\S+#(?!#)\\S+$"
    },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    }
  }
}
