{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.dev/schemas/project-success-criteria.schema.json",
  "title": "SDD Project Success Criteria Specification",
  "description": "Schema for specs/project/success-criteria.(yaml|yml|json) documents.",
  "type": "object",
  "required": ["criteria"],
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^\\S+#(?!#)\\S+$"
    },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    },
    "criterion": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "refs": { "$ref": "#/$defs/ref_list" }
      }
    }
  }
}
