{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.dev/schemas/data-models.schema.json",
  "title": "SDD Data Model Specification",
  "description": "Schema for specs/models/*.(yaml|yml|json) documents. One entity payload per file.",
  "type": "object",
  "required": ["id", "name", "fields"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "api_surface": {
      "type": "string",
      "enum": ["internal", "external"],
      "description": "Whether this model entity crosses the API boundary. Internal models are framework-private (parsed IR, graph-node types, branch metadata) and are exempt from DtoMapping coverage expectations. Defaults to `external` when absent."
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "refs": { "$ref": "#/$defs/ref_list" }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["name", "type", "target"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["has_many", "has_one", "belongs_to"]
        },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^\\S+#(?!#)\\S+$"
    },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    }
  }
}
