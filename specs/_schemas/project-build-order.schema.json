{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.dev/schemas/project-build-order.schema.json",
  "title": "SDD Project Build Order Specification",
  "description": "Schema for specs/project/build-order.(yaml|yml|json) documents.",
  "type": "object",
  "required": ["phases"],
  "additionalProperties": false,
  "properties": {
    "phases": {
      "type": "array",
      "items": { "$ref": "#/$defs/phase" }
    },
    "refs": { "$ref": "#/$defs/ref_list" }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^\\S+#(?!#)\\S+$"
    },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    },
    "phase": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fr_assignments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
