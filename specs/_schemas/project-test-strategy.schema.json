{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.dev/schemas/project-test-strategy.schema.json",
  "title": "SDD Project Test Strategy Specification",
  "description": "Schema for specs/project/test-strategy.(yaml|yml|json) documents.",
  "type": "object",
  "required": ["tiers"],
  "additionalProperties": false,
  "properties": {
    "tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/tier" }
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "mutation_operators": {
      "type": "array",
      "items": { "$ref": "#/$defs/mutation_operator" }
    },
    "scenario_budget": { "type": "integer" },
    "spec_delta_scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/spec_delta_scenario" }
    },
    "scale_tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/scale_tier" }
    },
    "parity_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/parity_rule" }
    },
    "fixture_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixture_requirement" }
    },
    "refs": { "$ref": "#/$defs/ref_list" }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^\\S+#(?!#)\\S+$"
    },
    "ref_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" },
      "uniqueItems": true
    },
    "tier": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "neo4j_required": { "type": "boolean" },
        "estimated_count": { "type": "integer" }
      }
    },
    "category": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "estimated_count": { "type": "integer" }
      }
    },
    "mutation_operator": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "spec_delta_scenario": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "scale_tier": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "estimated_specs": { "type": "integer" }
      }
    },
    "parity_rule": {
      "type": "object",
      "required": ["format", "comparison_method"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "comparison_method": { "type": "string", "minLength": 1 }
      }
    },
    "fixture_requirement": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
